{% macro archiveLink(record) -%}<a href="{{ record.archive_url }}" target="_blank" rel="noopener noreferrer">{{ record.id }} · {{ record.timestamp | dateStamp }} ↗</a>{%- endmacro %}
{% macro workCard(work, records) -%}<details class="catalog-entry" data-catalog-item><summary><strong>{{ work.title }}</strong><span>{{ work.authors | join(', ') }} · {{ work.genre }} · {{ work.period }} · {{ work.status }}</span></summary><p>{{ work.note }}</p><p>{{ archiveLink(records[work.page]) }}</p></details>{%- endmacro %}
{% macro documentCard(record) -%}<details class="catalog-entry" data-catalog-item data-source-record="{{ record.id }}"><summary><strong>{{ record.filename }}</strong><span>{{ record.mimetype }} · {{ record.catalog_status or record.status }}</span></summary><p><code>{{ record.original_url }}</code></p><p>{{ archiveLink(record) }}</p></details>{%- endmacro %}
{% macro imageCard(image, records) -%}<details class="catalog-entry" data-catalog-item><summary><strong>{{ image.filename }}</strong><span>{{ image.status }}</span></summary><p><code>{{ image.original_url }}</code></p><p>{% for id in image.sources | concat(image.dlc_records or []) %}{{ archiveLink(records[id]) }}{% if not loop.last %} · {% endif %}{% endfor %}</p></details>{%- endmacro %}
{% macro personCard(person, records, focused=false) -%}<details{% if focused %} open{% endif %} class="catalog-entry" data-catalog-item data-person-id="{{ person.id }}"><summary><strong>{{ person.name }}</strong><span>{{ person.works.length }} tekijämerkintää · {{ person.documents.length }} DLC-tiedostoviitettä</span></summary><p><a href="{{ ('/tekijat/' + person.id + '/') | localUrl }}">Avaa henkilösivu ↗</a></p>{% if person.observations.length %}<h4>Lähteiden henkilömerkinnät</h4><ul>{% for observation in person.observations %}<li>{{ observation.kind }}{% if observation.detail %} — {{ observation.detail }}{% endif %} · {{ archiveLink(records[observation.source]) }}<br /><small>{{ observation.name_basis }}</small></li>{% endfor %}</ul>{% endif %}{% if person.works.length %}<h4>Tekijäksi merkityt runot ja muut tuotokset</h4><ul>{% for work in person.works %}<li>{{ work.title }} · {{ work.genre }} · {{ work.period }} · {{ archiveLink(records[work.page]) }}</li>{% endfor %}</ul>{% endif %}{% if person.documents.length %}<h4>Omat sivut, kirjoitelmat ja kuvaviitteet DLC-arkistossa</h4><ul>{% for document in person.documents %}<li>{{ document.filename }} — {{ document.status }} · {{ archiveLink(document) }}</li>{% endfor %}</ul>{% endif %}<p>Myöhemmät vaiheet: tähän korttiin ei ole vielä liitetty nykyisiä henkilöprofiileja. Kortti säilyttää historiallisen nimimerkinnän ja sen lähteet.</p></details>{%- endmacro %}
