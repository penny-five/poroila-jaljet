{% if presentation == 'original' %}{% include "partials/head-original.njk" %}{% else %}{% include "partials/head-article.njk" %}{% endif %}
<body{% if legacyPage %} data-page="{{ legacyPage }}"{% endif %} data-features="{{ features | join(' ') }}">
<div class="scanline" aria-hidden="true"></div>
{% if presentation != 'original' %}<a class="skip-link" href="#sisalto">Siirry sisältöön</a>{% endif %}
{% include "partials/navigation.njk" %}
<main{% if presentation != 'original' %} id="sisalto"{% endif %}>
{% include "partials/breadcrumbs.njk" %}
{% include "partials/page-heading.njk" %}
{{ content | safe }}
</main>
{% set footer %}{% if presentation == 'original' %}{% include "partials/footer-original.njk" %}{% else %}{% include "partials/footer-article.njk" %}{% endif %}{% endset %}{{ footer | prefixPaths | safe }}
{% if 'articles' in features %}{% include "partials/article-dialog.njk" %}{% endif %}
{% if 'board' in features %}<script type="application/json" id="graph-data">{{ graphView | toJson | safe }}</script>{% endif %}
<script type="application/json" id="legacy-route-map">{{ legacyRoutes | toJson | safe }}</script>
<script defer src="{{ '/legacy-routes.js' | localUrl }}"></script>
<script type="module" src="{{ '/assets/main.js' | localUrl }}"></script>
</body></html>
