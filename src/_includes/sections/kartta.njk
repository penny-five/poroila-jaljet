{% import "research/macros.njk" as ui with context %}
<section id="kartta" class="board-section section-pad"><div class="section-tag">YHTEYDET ≠ SYYLLISYYS</div>
<div class="board-controls"><div class="filter-group" role="group" aria-label="Suodata kartan kohteita"><button class="filter active" data-filter="all">Kaikki</button><button class="filter" data-filter="person">Henkilöt</button><button class="filter" data-filter="institution">Instituutiot</button><button class="filter" data-filter="document">Dokumentit</button><button class="filter" data-filter="open">Avoimet yhteydet</button></div><button id="resetBoard" class="reset-btn">↺ PALAUTA KORTIT</button></div>
<div class="board-viewport" aria-label="Vieritettävä korkkitaulu"><div class="corkboard" id="corkboard"><div class="board-label">LÄHDEKARTTA / 001 <span>JULKISET LÄHTEET</span></div><svg id="strings" class="strings" aria-hidden="true"></svg><div id="boardNodes" class="board-nodes">{% set rotations = [-2,2,-3,4,-2,3,1,-2,1,-3,4,-4,3,2] %}{% for node in graph.nodes %}{{ ui.nodeCard(node, rotations[loop.index0], loop.first) }}{% endfor %}</div><div class="cork-stamp">YHTEYS TARVITSEE<br />PERUSTELUN</div></div></div>
<div class="board-legend"><span><i class="legend-line solid"></i> Lähteessä dokumentoitu suhde</span><span><i class="legend-line dashed"></i> Avoin henkilöllisyys-/asiayhteys</span><span><span class="legend-pin"></span> Valitse kortti ja katso lähteet</span><span class="scroll-hint">MOBIILILLA: LIIKUTA TAULUA SIVUSUUNNASSA →</span></div>
<div class="node-detail" id="nodeDetail" aria-live="polite">{{ ui.nodeDetail(graph.nodes[0], research.sources) }}</div>
</section>