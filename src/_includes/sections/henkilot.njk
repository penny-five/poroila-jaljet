{% import "catalog/macros.njk" as cards with context %}
<section id="henkilot" class="oral-page section-pad"><label class="catalog-search"{% if focusedPerson %} hidden{% endif %}>Hae henkilömerkintöjä<input type="search" data-catalog-search="personCatalog" placeholder="Hae nimellä, otsikolla tai tiedostolla…" /></label><p{% if focusedPerson %} hidden{% endif %} data-catalog-count="personCatalog" aria-live="polite">{{ 1 if focusedPerson else catalog.people.length }} / {{ 1 if focusedPerson else catalog.people.length }} merkintää</p><p id="personBack"{% if not focusedPerson %} hidden{% endif %}><a href="#/henkilot">← Kaikki henkilömerkinnät</a></p><div id="personCatalog">{% for record in ([focusedPerson] if focusedPerson else catalog.people) %}{{ cards.personCard(record, catalog.recordsById, focusedPerson) }}{% endfor %}</div></section>