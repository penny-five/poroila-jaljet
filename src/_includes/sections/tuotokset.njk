{% import "catalog/macros.njk" as cards with context %}
<section id="tuotokset" class="oral-page section-pad"><p data-archive-expansion>{{ catalog.works.length }} teostietuetta · {{ catalog.distinctWorksCount }} erillistä teosta. Saman teoksen rinnakkaistallenteet on merkitty, ja niiden pysyvät tunnisteet säilyvät.</p><label class="catalog-search">Hae tuotoksia<input type="search" data-catalog-search="workCatalog" placeholder="Hae nimellä, otsikolla tai tiedostolla…" /></label><p data-catalog-count="workCatalog" aria-live="polite">{{ catalog.works.length }} / {{ catalog.works.length }} merkintää</p><div id="workCatalog">{% for work in catalog.works %}{{ cards.workCard(work, catalog.recordsById) }}{% endfor %}</div></section>