{% set currentSection = navigation.sections | sectionForPath(page.url) %}
<header class="topbar"><a class="brand" href="{{ '/' | localUrl }}" aria-label="Hyrsylä / Jäljet, etusivulle"><span class="brand-glyph">◈</span> HYRSYLÄ<span class="brand-slash">/</span>JÄLJET</a><nav id="navigation" class="nav" aria-label="Päävalikko">{% for item in navigation.primary %}<a href="{{ item.url | localUrl }}"{% if item | primaryIsCurrent(navigation.primary, page.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav></header>
{% if currentSection and currentSection.links.length > 1 %}
<nav id="sectionNavigation" class="section-navigation" aria-label="{{ currentSection.label }}">
  {% for item in currentSection.links %}<a href="{{ item.url | localUrl }}"{% if item | navItemIsCurrent(page.url) %} aria-current="{{ 'page' if item.url == page.url else 'location' }}"{% endif %}>{{ item.label }}</a>{% endfor %}
</nav>
{% else %}<nav id="sectionNavigation" class="section-navigation" aria-label="Osion alasivut" hidden></nav>{% endif %}
{% set currentCollection = navigation.collections | sectionForPath(page.url) %}
{% if currentCollection %}
<nav id="collectionNavigation" class="collection-navigation" aria-label="{{ currentCollection.label }}">
  <span class="collection-navigation-label">Aineistoryhmät</span>
  <div class="collection-navigation-links">
    {% for item in currentCollection.links %}<a href="{{ item.url | localUrl }}"{% if item | navItemIsCurrent(page.url) %} aria-current="{{ 'page' if item.url == page.url else 'location' }}"{% endif %}>{{ item.label }}</a>{% endfor %}
  </div>
</nav>
{% endif %}
