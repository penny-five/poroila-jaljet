{% set original = presentation == 'original' %}
{% set group = navigation.original.groups | legacyGroup(legacyPage) %}
{% set currentSection = navigation.sections | sectionForPath(page.url) %}
<header class="topbar"><a class="brand" href="{{ '/' | localUrl }}" aria-label="{{ 'Alkuun' if original else 'Hyrsylä / Jäljet, alkuun' }}"><span class="brand-glyph">◈</span> HYRSYLÄ<span class="brand-slash">/</span>JÄLJET</a><nav id="navigation" class="nav" aria-label="Päävalikko">{% for item in navigation.primary %}<a href="{{ (legacyRoutes[item.id] if original else item.url) | localUrl }}"{% if (original and item.id == group.home) or (not original and item | primaryIsCurrent(navigation.primary, page.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav></header>
{% if original %}<nav id="sectionNavigation" class="section-navigation" aria-label="Osion alasivut"{% if group.pages.length < 2 %} hidden{% endif %}>{% for id in group.pages %}<a href="{{ legacyRoutes[id] | localUrl }}"{% if id == legacyPage %} aria-current="page"{% endif %}>{{ navigation.original.names[id] }}</a>{% endfor %}</nav>
{% elif currentSection and currentSection.links.length > 1 %}<nav id="sectionNavigation" class="section-navigation" aria-label="{{ currentSection.label }}">{% for item in currentSection.links %}<a href="{{ item.url | localUrl }}"{% if item | navItemIsCurrent(page.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav>{% endif %}
