{% set group = research.navigation.groups | legacyGroup(legacyPage) %}
<header class="topbar"><a class="brand" href="{{ '/' | localUrl }}" aria-label="Alkuun"><span class="brand-glyph">◈</span> HYRSYLÄ<span class="brand-slash">/</span>JÄLJET</a><nav id="navigation" class="nav" aria-label="Päävalikko">{% for item in [{id:'alku',label:'Alku'}, {id:'sivujaljet',label:'Verkkosivut'}, {id:'koulu',label:'Koulu ja ihmiset'}, {id:'aineisto',label:'Poroila'}, {id:'fiktiot',label:'Fiktio'}, {id:'lahteet',label:'Lähteet'}] %}<a href="{{ legacyRoutes[item.id] | localUrl }}"{% if item.id == group.home %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav></header><nav id="sectionNavigation" class="section-navigation" aria-label="Osion alasivut"{% if group.pages.length < 2 %} hidden{% endif %}>{% for id in group.pages %}<a href="{{ legacyRoutes[id] | localUrl }}"{% if id == legacyPage %} aria-current="page"{% endif %}>{{ research.navigation.names[id] }}</a>{% endfor %}</nav>
