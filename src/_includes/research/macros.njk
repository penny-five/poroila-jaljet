{% macro sourceLink(source) -%}<a href="{{ (source.localPath or source.url) | localUrl }}" {% if not source.localPath %}target="_blank"{% endif %} rel="noopener noreferrer">[{{ source.id }}] {{ source.title }} ↗</a>{%- endmacro %}
{% macro timelineRow(row, sources) -%}<article class="time-row {{ 'open' if row.open else '' }}" data-year="{{ row.year }}"{% if row.addition %} data-archive-expansion{% endif %}><div class="time-year">{{ row.year }}</div><div class="time-dot"></div><div><p class="time-title">{{ row.title }}</p><p class="time-summary">{{ row.description }}</p></div><div class="time-refs">{% for id in row.refs %}{% set source = sources | findSource(id) %}<a href="{{ (source.localPath or source.url or '#') | localUrl }}" rel="noopener noreferrer" {% if not source.localPath %}target="_blank"{% endif %}>[{{ id }}] ↗</a>{% endfor %}</div></article>{%- endmacro %}
{% macro sourceRow(source) -%}{% set kind = source.group | sourceType %}<a class="source-entry" data-source-kind="{{ kind }}" data-publisher="{{ source.publisher }}" href="{{ (source.localPath or source.url) | localUrl }}" {% if not source.localPath %}target="_blank"{% endif %} rel="noopener noreferrer"><span class="source-index">{{ source.id }}</span><span class="source-date">{{ source.date }}</span><div><h3>{{ source.title }}</h3><p>{{ source.note }}</p></div><span class="source-kind">{{ source.publisher }}<br>↳ {{ kind | sourceLabel }}</span><span class="source-link-arrow">↗</span></a>{%- endmacro %}
{% macro nodeCard(node, rotation, first) -%}<button class="node paper-{{ node.type }}{{ ' active' if first else '' }}" data-id="{{ node.id }}" data-type="{{ node.type }}" id="node-{{ node.id }}" style="left:{{ node.position.x }}px;top:{{ node.position.y }}px;--rot:{{ rotation }}deg" aria-label="Avaa kortti: {{ node.name }}"><span class="node-tape"></span><span class="node-type">{{ node.label }}</span><strong class="node-title">{{ node.name }}</strong><span class="node-sub">{{ node.subtitle }}</span></button>{%- endmacro %}
{% macro nodeDetail(node, sources) -%}<div class="detail-id">VALITTU JOHTOLANKA <span>001 / 014</span></div><h3>{{ node.name }}</h3><div class="detail-notice">{{ node.evidenceStatus }}</div><p>{{ node.description }}</p><div class="node-sources">{% for id in node.refs %}{{ sourceLink(sources | findSource(id)) }}{% endfor %}</div>{%- endmacro %}
